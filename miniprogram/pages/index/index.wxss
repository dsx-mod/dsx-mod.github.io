.hero {
  padding: 48rpx 40rpx 24rpx;
}

.hero-title {
  font-size: 44rpx;
  font-weight: 700;
  letter-spacing: 6rpx;
  color: var(--text-0);
  background: linear-gradient(120deg, #f4f9ff 0%, #cfe6f4 42%, #8bdcf5 100%);
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
}

.hero-sub {
  font-size: 25rpx;
  line-height: 1.6;
  color: var(--text-3);
  margin-top: 12rpx;
}

@media (prefers-color-scheme: light) {
  .hero-title {
    background: linear-gradient(120deg, #0b2033 0%, #155e75 55%, #0891b2 100%);
    -webkit-background-clip: text;
    background-clip: text;
  }
}

/* 步骤标签吸顶：原生页面滚动 + position: sticky */
.nav {
  position: sticky;
  top: 0;
  z-index: 30;
  background: var(--nav-bg);
  border-bottom: 1rpx solid var(--line);
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.32);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  padding: 4rpx 0;
}

/* 非首步没有 hero：标签栏直接固定到内容区顶部，消除吸顶前的空隙 */
.nav-flush {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
}

.nav-spacer {
  height: 138rpx;
}

.tabs {
  display: flex;
  flex-wrap: wrap;
  padding: 0 20rpx;
}

.tab {
  flex: 0 0 calc((100% - 40rpx) / 5);
  width: calc((100% - 40rpx) / 5);
  box-sizing: border-box;
  height: 60rpx;
  line-height: 60rpx;
  margin-top: 0;
  padding: 0;
  border-radius: 16rpx;
  border: 1rpx solid transparent;
  font-size: 21rpx;
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
  color: var(--text-2);
  background: transparent;
}

.tab:nth-child(5n + 1),
.tab:nth-child(5n + 2),
.tab:nth-child(5n + 3),
.tab:nth-child(5n + 4) {
  margin-right: 10rpx;
}

.tab:nth-child(n + 6) {
  margin-top: 10rpx;
}

.tab.on {
  background: linear-gradient(135deg, #8fe3f7, #46b9dd);
  border-color: transparent;
  color: #05202b;
  font-weight: 600;
  box-shadow: 0 8rpx 20rpx rgba(70, 185, 221, 0.3);
}

.progress {
  padding: 10rpx 24rpx 12rpx;
  font-size: 22rpx;
  line-height: 1.3;
  letter-spacing: 4rpx;
  color: var(--text-3);
}

.chips {
  display: flex;
  flex-wrap: wrap;
  margin: 4rpx 0 8rpx;
}

.chip {
  padding: 12rpx 22rpx;
  margin: 0 12rpx 12rpx 0;
  border-radius: 14rpx;
  background: var(--input-bg);
  border: 1rpx solid var(--line);
  font-size: 24rpx;
  color: var(--text-2);
}

.chip.on {
  background: rgba(139, 220, 245, 0.14);
  border-color: rgba(139, 220, 245, 0.5);
  color: var(--ice);
  font-weight: 600;
}

.chip.dis {
  opacity: 0.45;
}

.count-line {
  font-size: 26rpx;
  color: var(--text-2);
  margin: 6rpx 0 10rpx;
}

.shot {
  display: block;
  width: 100%;
  margin: 16rpx 0 8rpx;
  border-radius: 20rpx;
  border: 1rpx solid var(--line);
  background: rgba(255, 255, 255, 0.04);
}

.gallery {
  white-space: nowrap;
  margin-top: 8rpx;
}

.thumb {
  display: inline-block;
  width: 220rpx;
  height: 165rpx;
  margin-right: 12rpx;
  border-radius: 14rpx;
  border: 1rpx solid var(--line);
  background: rgba(255, 255, 255, 0.04);
}

/* 悬浮翻页：固定 88×88rpx 正方形，view 承载避免 button 默认盒模型拉伸 */
.fab,
.fab-skip {
  flex: 0 0 88rpx;
  width: 88rpx;
  min-width: 88rpx;
  max-width: 88rpx;
  height: 88rpx;
  min-height: 88rpx;
  max-height: 88rpx;
  padding: 0;
  margin: 0;
  box-sizing: border-box;
  border-radius: 20rpx;
  text-align: center;
  overflow: hidden;
}

.fab {
  line-height: 88rpx;
  font-size: 40rpx;
  font-weight: 600;
  background: linear-gradient(135deg, #8fe3f7, #46b9dd);
  color: #05202b;
  box-shadow: 0 10rpx 28rpx rgba(70, 185, 221, 0.3);
  z-index: 45;
}

.fab.prev {
  position: fixed;
  left: 20rpx;
  bottom: calc(150rpx + env(safe-area-inset-bottom));
}

.fab.dis {
  opacity: 0.35;
}

.fab-right {
  position: fixed;
  right: 20rpx;
  bottom: calc(150rpx + env(safe-area-inset-bottom));
  z-index: 45;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: flex-end;
  flex-wrap: nowrap;
}

.fab-skip {
  line-height: 88rpx;
  margin-right: 40rpx;
  border: 1rpx solid rgba(245, 166, 66, 0.55);
  font-size: 24rpx;
  font-weight: 600;
  color: #2b1a06;
  background: rgba(245, 166, 66, 0.92);
  box-shadow: 0 10rpx 26rpx rgba(0, 0, 0, 0.36);
  z-index: 45;
}

.bottom-space {
  height: 300rpx;
}

.bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 50;
  padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  background: var(--bar-bg);
  border-top: 1rpx solid var(--line);
  box-shadow: 0 -12rpx 40rpx rgba(0, 0, 0, 0.4);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  display: flex;
  flex-direction: row;
  align-items: center;
}

/* 左列：价格与未选提示，与右侧按钮垂直居中 */
.bar-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding-right: 12rpx;
}

.bar-total {
  font-size: 30rpx;
  line-height: 1.35;
  font-weight: 700;
  color: var(--ice);
  word-break: break-all;
}

.bar-sub {
  font-size: 22rpx;
  line-height: 1.4;
  color: var(--text-3);
  word-break: break-all;
}

/* 右列：两个按钮同行并排 */
.bar-actions {
  display: flex;
  flex-direction: row;
  align-items: center;
  flex-shrink: 0;
}

.bar-actions .bar-btn {
  width: 210rpx;
  flex-shrink: 0;
  margin: 0;
  padding: 0 12rpx;
  font-size: 24rpx;
  white-space: nowrap;
}

.bar-actions .bar-btn + .bar-btn {
  margin-left: 12rpx;
}

.bar-btn {
  height: 76rpx;
  line-height: 76rpx;
  padding: 0 26rpx;
  margin: 0 0 0 12rpx;
  border-radius: 20rpx;
  font-size: 26rpx;
}

.bar-btn.ghost {
  background: rgba(255, 255, 255, 0.06);
  border: 1rpx solid var(--line);
  color: var(--text-0);
}

.bar-btn.share {
  background: linear-gradient(135deg, #8fe3f7, #46b9dd);
  color: #05202b;
  font-weight: 600;
  box-shadow: 0 10rpx 28rpx rgba(70, 185, 221, 0.3);
}

.bar-btn.share[disabled] {
  opacity: 0.5;
}

@media (prefers-color-scheme: light) {
  .bar-btn.ghost {
    background: rgba(23, 58, 88, 0.05);
  }
}

/* 只读配置单 */
.srow {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 16rpx 0;
  border-bottom: 1rpx dashed rgba(148, 197, 227, 0.12);
  font-size: 27rpx;
}

.sname {
  flex: 1;
  padding-right: 20rpx;
  color: var(--text-1);
}

.sprice {
  color: var(--ice);
  font-weight: 600;
  flex-shrink: 0;
}

.total-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--line);
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-0);
}

.total-row .total {
  color: var(--ice);
  font-size: 40rpx;
}

.ro-actions {
  padding: 8rpx 24rpx 48rpx;
}

.btn {
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 24rpx;
  font-size: 30rpx;
  margin-bottom: 20rpx;
}

.btn.primary {
  background: linear-gradient(135deg, #8fe3f7, #46b9dd);
  color: #05202b;
  font-weight: 600;
  box-shadow: 0 12rpx 34rpx rgba(70, 185, 221, 0.26);
}

.btn.ghost {
  background: rgba(255, 255, 255, 0.06);
  border: 1rpx solid var(--line);
  color: var(--text-0);
}

@media (prefers-color-scheme: light) {
  .btn.ghost {
    background: rgba(23, 58, 88, 0.05);
  }
}

/* 弹层 */
.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(3, 6, 10, 0.72);
  z-index: 90;
  display: flex;
  align-items: flex-end;
}

.panel {
  width: 100%;
  max-height: 82vh;
  background: var(--bg-0);
  border-top: 1rpx solid var(--line);
  border-radius: 32rpx 32rpx 0 0;
  display: flex;
  flex-direction: column;
  box-shadow: 0 -20rpx 60rpx rgba(0, 0, 0, 0.5);
}

.panel-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 28rpx 28rpx 16rpx;
  border-bottom: 1rpx solid var(--line);
  background: linear-gradient(135deg, rgba(139, 220, 245, 0.14), rgba(92, 200, 234, 0.04));
}

.panel-title {
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  color: var(--text-0);
}

.panel-meta {
  font-size: 22rpx;
  color: var(--text-3);
  margin-top: 4rpx;
}

.panel-close {
  font-size: 48rpx;
  line-height: 1;
  color: var(--text-3);
  padding: 0 8rpx;
}

.panel-body {
  flex: 1;
  padding: 8rpx 28rpx;
  max-height: 52vh;
}

.panel-foot {
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--line);
  display: flex;
  align-items: center;
}

.panel-total {
  flex: 1;
  font-size: 26rpx;
  color: var(--text-2);
}

.panel-total .total {
  color: var(--ice);
  font-size: 34rpx;
  font-weight: 700;
}

.ta {
  width: 100%;
  min-height: 120rpx;
  background: var(--input-bg);
  border: 1rpx solid var(--line);
  border-radius: 16rpx;
  padding: 16rpx;
  font-size: 26rpx;
  color: var(--text-0);
  margin-bottom: 16rpx;
}

/* 图片预览 */
.preview {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.92);
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
}

.preview-img {
  width: 100%;
  height: 100%;
}
