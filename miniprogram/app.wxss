/* 全局样式：与网站新版“冷调钛灰 + 冰川蓝”主题保持一致 */
page {
  --bg-0: #070a0f;
  --line: rgba(148, 197, 227, 0.14);
  --line-strong: rgba(148, 197, 227, 0.30);
  --text-0: #eef5fb;
  --text-1: #c2d2e0;
  --text-2: #8fa3b8;
  --text-3: #64788c;
  --ice: #8bdcf5;
  --ice-strong: #5cc8ea;
  --danger: #ff7a8a;
  --card-bg: linear-gradient(180deg, rgba(20, 31, 43, 0.78) 0%, rgba(11, 17, 24, 0.82) 100%);
  --card-shadow: 0 24rpx 70rpx rgba(0, 0, 0, 0.45), inset 0 1rpx 0 rgba(255, 255, 255, 0.04);
  --nav-bg: rgba(15, 26, 36, 0.96);
  --bar-bg: rgba(15, 26, 36, 0.97);
  --input-bg: rgba(7, 12, 18, 0.72);

  background:
    linear-gradient(180deg, #0f1a24 0%, rgba(15, 26, 36, 0) 300rpx),
    radial-gradient(1200rpx 640rpx at 10% -12%, rgba(92, 200, 234, 0.16), transparent 62%),
    radial-gradient(900rpx 700rpx at 92% -4%, rgba(96, 165, 250, 0.12), transparent 58%),
    radial-gradient(900rpx 900rpx at 50% 118%, rgba(45, 212, 191, 0.08), transparent 62%),
    var(--bg-0);
  min-height: 100vh;
  color: var(--text-1);
  font-size: 28rpx;
  line-height: 1.6;
  font-family: -apple-system, 'HarmonyOS Sans SC', 'MiSans', 'PingFang SC', 'Microsoft YaHei', sans-serif;
}

@media (prefers-color-scheme: light) {
  page {
    --bg-0: #eef3f8;
    --line: rgba(23, 58, 88, 0.12);
    --line-strong: rgba(23, 58, 88, 0.26);
    --text-0: #0f2233;
    --text-1: #2b4258;
    --text-2: #566e84;
    --text-3: #71879b;
    --ice: #0e7490;
    --ice-strong: #0891b2;
    --danger: #c4304a;
    --card-bg: linear-gradient(180deg, rgba(255, 255, 255, 0.88) 0%, rgba(247, 251, 254, 0.92) 100%);
    --card-shadow: 0 18rpx 50rpx rgba(31, 71, 102, 0.10), inset 0 1rpx 0 rgba(255, 255, 255, 0.9);
    --nav-bg: rgba(247, 251, 254, 0.96);
    --bar-bg: rgba(247, 251, 254, 0.97);
    --input-bg: rgba(240, 246, 251, 0.9);

    background:
      linear-gradient(180deg, #eef3f8 0%, rgba(238, 243, 248, 0) 260rpx),
      radial-gradient(1200rpx 640rpx at 10% -12%, rgba(8, 145, 178, 0.10), transparent 62%),
      radial-gradient(900rpx 700rpx at 92% -4%, rgba(59, 130, 246, 0.08), transparent 58%),
      radial-gradient(900rpx 900rpx at 50% 118%, rgba(13, 148, 136, 0.06), transparent 62%),
      var(--bg-0);
  }
}

view, text, button, input, textarea, scroll-view, image {
  box-sizing: border-box;
}

.card {
  position: relative;
  background: var(--card-bg);
  border: 1rpx solid var(--line);
  border-radius: 40rpx;
  padding: 40rpx 36rpx;
  margin: 0 24rpx 32rpx;
  box-shadow: var(--card-shadow);
  overflow: hidden;
}

.card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 12%;
  right: 12%;
  height: 1rpx;
  background: linear-gradient(90deg, transparent, rgba(139, 220, 245, 0.42), transparent);
  pointer-events: none;
}

.section-title {
  font-size: 36rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  color: var(--text-0);
  padding: 2rpx 0 20rpx 20rpx;
  margin-bottom: 20rpx;
  border-bottom: 1rpx solid var(--line);
  border-left: 4rpx solid var(--ice-strong);
  background: linear-gradient(90deg, rgba(139, 220, 245, 0.08), transparent 72%);
}

.section-hint {
  font-size: 25rpx;
  line-height: 1.5;
  color: #f3c78a;
  background: rgba(245, 166, 66, 0.10);
  border: 1rpx solid rgba(245, 166, 66, 0.20);
  border-left: 4rpx solid rgba(245, 166, 66, 0.62);
  border-radius: 16rpx;
  padding: 16rpx 22rpx;
  margin: 0 0 20rpx;
}

.group-title {
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  color: var(--text-0);
  padding-left: 16rpx;
  border-left: 3rpx solid rgba(139, 220, 245, 0.6);
  margin: 32rpx 0 16rpx;
}

.hint-text {
  font-size: 24rpx;
  line-height: 1.6;
  color: #f3c78a;
  background: rgba(245, 166, 66, 0.10);
  border: 1rpx solid rgba(245, 166, 66, 0.20);
  border-left: 3rpx solid rgba(245, 166, 66, 0.62);
  border-radius: 16rpx;
  padding: 14rpx 20rpx;
  margin: 8rpx 0 18rpx;
}

@media (prefers-color-scheme: light) {
  .section-hint,
  .hint-text {
    color: #8a4d0a;
    background: rgba(255, 152, 0, 0.12);
    border-color: rgba(214, 124, 20, 0.24);
    border-left-color: rgba(214, 124, 20, 0.7);
  }
}

.warn-text {
  font-size: 24rpx;
  line-height: 1.55;
  color: #f5c26b;
  background: rgba(245, 194, 107, 0.08);
  border-left: 3rpx solid rgba(245, 194, 107, 0.55);
  border-radius: 12rpx;
  padding: 14rpx 20rpx;
  margin: 12rpx 0 18rpx;
}

.price-text {
  color: var(--ice);
  font-weight: 600;
}

.muted {
  color: var(--text-3);
}

button::after {
  border: none;
}
